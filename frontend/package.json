{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev": "tauri dev",
    "tauri": "tauri",
    "fresh": "rm node_modules package-lock.json && npm install && npm run dev"
